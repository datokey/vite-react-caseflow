# Frontend React (Vite) environment example
# Copy file ini menjadi .env di project frontend React.

# URL frontend yang diizinkan oleh CORS backend.
VITE_APP_URL=http://localhost:5173

# URL backend.
VITE_API_ORIGIN=http://localhost:5000
VITE_API_BASE_URL=http://localhost:5000/api

# Health check / server check
VITE_ENDPOINT_ROOT=/
VITE_ENDPOINT_PING=/ping

# Auth endpoints
VITE_ENDPOINT_AUTH_REGISTER=/api/auth/register
VITE_ENDPOINT_AUTH_LOGIN=/api/auth/login
VITE_ENDPOINT_AUTH_LOGOUT=/api/auth/logout
VITE_ENDPOINT_AUTH_ME=/api/auth/me

# Template SOP endpoints
VITE_ENDPOINT_ARTICLES=/api/template-sops
VITE_ENDPOINT_ARTICLES_SEARCH=/api/template-sops/search
VITE_ENDPOINT_ARTICLE_DETAIL=/api/template-sops/:id

# Recording endpoints
VITE_ENDPOINT_RECORDING_TODAY=/api/ticket-counters/today
VITE_ENDPOINT_RECORDING_INCREMENT=/api/ticket-counters/increment
VITE_ENDPOINT_RECORDING_DECREMENT=/api/ticket-counters/decrement
VITE_ENDPOINT_RECORDING_RESET=/api/ticket-counters/reset


# User endpoints
VITE_ENDPOINT_USERS=/api/users
VITE_ENDPOINT_USERS_SEARCH=/api/users/search
VITE_ENDPOINT_USER_DETAIL=/api/users/:id
VITE_ENDPOINT_USERS_BY_ROLE=/api/users/role/:role

# Metadata endpoints
VITE_ENDPOINT_METADATA=/api/metadata
VITE_ENDPOINT_METADATA_SEARCH=/api/metadata/search
VITE_ENDPOINT_METADATA_DETAIL=/api/metadata/:id

# Common query params untuk endpoint search:
# q=<keyword>&page=1&limit=10
